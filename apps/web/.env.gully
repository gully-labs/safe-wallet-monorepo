# Gully Safe build-time configuration (public values only, no secrets).
# Loaded by apps/web/scripts/gully-build.sh. Next.js inlines NEXT_PUBLIC_* at build time.

# Backend: Gully Client Gateway. The app appends /v1/... to this base (no trailing slash).
NEXT_PUBLIC_IS_PRODUCTION=true
NEXT_PUBLIC_GATEWAY_URL_PRODUCTION=https://safe.gullychain.xyz/cgw
NEXT_PUBLIC_GATEWAY_URL_STAGING=https://safe.gullychain.xyz/cgw

# Default chain: Gully Chain Testnet (485590, shortName gully-test).
# IS_PRODUCTION=true selects the MAINNET default, so both point at 485590 until Gully Chain mainnet exists.
NEXT_PUBLIC_DEFAULT_MAINNET_CHAIN_ID=485590
NEXT_PUBLIC_DEFAULT_TESTNET_CHAIN_ID=485590
NEXT_PUBLIC_SAFE_VERSION=1.4.1

# Branding. Not an official Safe host: Safe's own terms/privacy/cookie texts are not shown.
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
NEXT_PUBLIC_BRAND_NAME="Gully Safe"
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_SAFE_STATUS_PAGE_URL=https://gullylabs.xyz

# Analytics and telemetry: all off (empty disables each one).
NEXT_PUBLIC_PROD_GA_TRACKING_ID=
NEXT_PUBLIC_TEST_GA_TRACKING_ID=
NEXT_PUBLIC_SAFE_APPS_GA_TRACKING_ID=
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_RUM_APPLICATION_ID=
NEXT_PUBLIC_DATADOG_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DATADOG_FORCE_ENABLE=false
NEXT_PUBLIC_BEAMER_ID=
NEXT_TELEMETRY_DISABLED=1

# Third-party keys we do not have: all off.
# No WalletConnect project id: the WalletConnect wallet option is not offered (injected wallets and Ledger/Trezor only).
NEXT_PUBLIC_WC_PROJECT_ID=
# No Infura key: RPCs come from the chain config (Gully RPC), which must not use API_KEY_PATH authentication.
NEXT_PUBLIC_INFURA_TOKEN=
NEXT_PUBLIC_SAFE_APPS_INFURA_TOKEN=
NEXT_PUBLIC_BLOCKAID_CLIENT_ID=
NEXT_PUBLIC_TENDERLY_SIMULATE_ENDPOINT_URL=
NEXT_PUBLIC_TENDERLY_PROJECT_NAME=
NEXT_PUBLIC_TENDERLY_ORG_NAME=
NEXT_PUBLIC_HYPERNATIVE_CLIENT_ID=
NEXT_PUBLIC_FIREBASE_OPTIONS_PRODUCTION=
NEXT_PUBLIC_FIREBASE_OPTIONS_STAGING=
NEXT_PUBLIC_FIREBASE_VAPID_KEY_PRODUCTION=
NEXT_PUBLIC_FIREBASE_VAPID_KEY_STAGING=
