NEXT_PUBLIC_INFURA_TOKEN=1234567890
NEXT_PUBLIC_WC_PROJECT_ID=0987654321
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here, too

# Gully Safe: "Sign in with Gully ID" header button, on by default (identity only; wallet connection and signing unchanged).
# NEXT_PUBLIC_GULLY_ID_SIGNIN=off hides it. Blank client id / issuer = gully-safe / https://gullyid.xyz.
NEXT_PUBLIC_GULLY_ID_SIGNIN=on
NEXT_PUBLIC_GULLY_ID_CLIENT_ID=gully-safe
NEXT_PUBLIC_GULLY_ID_ISSUER=https://gullyid.xyz
